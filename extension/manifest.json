{
  "manifest_version": 3,
  "name": "Tenno Trade Helper",
  "version": "0.1.0",
  "description": "Scan your Warframe inventory from screenshots, see live warframe.market prices, and list or mark items sold in one click.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Tenno Trade Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": ["lib/backend.js", "background.js"]
  },
  "permissions": ["storage", "unlimitedStorage", "cookies", "alarms", "notifications"],
  "host_permissions": ["https://api.warframe.market/*", "https://warframe.market/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tenno-trade-helper@metacreator",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    }
  }
}
